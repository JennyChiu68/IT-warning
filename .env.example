HOST=127.0.0.1
PORT=4173
AUTO_SYNC=1
SYNC_MINUTES=15
# Optional NIST key. Leave empty to use the public limit.
NVD_API_KEY=
# Optional X API app-only Bearer token. The public Telegram feed runs without it.
X_DIGEST_BEARER_TOKEN=
# Set PUBLIC_URL to the deployed HTTPS H5 entry when serving the live RSS feed.
PUBLIC_URL=https://jennychiu68.github.io/IT-warning/
# Generate keys with npx web-push generate-vapid-keys.
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Enable public submissions after setting up comment moderation.
COMMENTS_ENABLED=0
# Configure all four values before enabling WeChat reminders.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ID=
WECHAT_TEMPLATE_FIELDS=
# Example field mapping; substitute the field names from the approved template:
# WECHAT_TEMPLATE_FIELDS={"thing1":"title","phrase2":"level","date3":"date","character_string4":"id"}
WECHAT_MINIPROGRAM_STATE=formal
